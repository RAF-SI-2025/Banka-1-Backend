# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=investment_fund_db
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_SECONDS=60

# Downstream services
BANKING_SERVICE_URL=http://localhost:8084
EMPLOYEE_SERVICE_URL=http://localhost:8081
ORDER_SERVICE_URL=http://localhost:8088

# Security — JWT_SECRET is required, no default; set a strong random value in production
JWT_SECRET=replace-with-a-strong-random-secret
JWT_ALGORITHM=HS256

# Commission charged on client withdrawals (0.005 = 0.5%)
COMMISSION_RATE=0.005

# Server
HOST=0.0.0.0
PORT=8092
